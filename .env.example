# LLM Configuration (Optional: The project runs fully offline out-of-the-box!)
# To connect to live models, configure your provider and API key below:

# Provider choice: "openai", "gemini", or "offline"
LLM_PROVIDER=offline

# Model names:
# OpenAI: "gpt-4o", "gpt-4o-mini"
# Gemini: "gemini-1.5-pro", "gemini-1.5-flash"
LLM_MODEL=simulation-engine

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
